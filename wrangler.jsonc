{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloodwake",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bloodwake-saves",
    // Local development only. npm run cloud:setup writes the real ID to
    // the ignored wrangler.deploy.json config before a remote deployment.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
